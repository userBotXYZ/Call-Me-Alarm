<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call-Me Event Alarm"
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Triggers a full-screen call 30 minutes before your event"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event / Caller Name (e.g., Standup Meeting)"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Phone Number to Call (e.g., +919876543210)"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B" />

        <CheckBox
            android:id="@+id/cbAutoDial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Place cellular call immediately when I tap Answer"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Select Event Time (Call rings 30 mins prior):"
            android:textColor="#38BDF8"
            android:textStyle="bold" />

        <TimePicker
            android:id="@+id/timePickerEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Active Days:"
            android:textColor="#38BDF8"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4">
            <CheckBox android:id="@+id/cbMon" android:text="Mon" android:checked="true" android:textColor="#FFF"/>
            <CheckBox android:id="@+id/cbTue" android:text="Tue" android:checked="true" android:textColor="#FFF"/>
            <CheckBox android:id="@+id/cbWed" android:text="Wed" android:checked="true" android:textColor="#FFF"/>
            <CheckBox android:id="@+id/cbThu" android:text="Thu" android:checked="true" android:textColor="#FFF"/>
            <CheckBox android:id="@+id/cbFri" android:text="Fri" android:checked="true" android:textColor="#FFF"/>
            <CheckBox android:id="@+id/cbSat" android:text="Sat" android:textColor="#FFF"/>
            <CheckBox android:id="@+id/cbSun" android:text="Sun" android:textColor="#FFF"/>
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Follow-Up Call Interval Option:"
            android:textColor="#38BDF8"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgRepeatInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbIntervalNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="No Repeat"
                android:textColor="#FFF" />
            <RadioButton
                android:id="@+id/rbInterval5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Every 5 Mins"
                android:textColor="#FFF" />
            <RadioButton
                android:id="@+id/rbInterval10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Every 10 Mins"
                android:textColor="#FFF" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveAlarm"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#10B981"
            android:text="Save &amp; Schedule 30-Min Pre-Call"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTestCallNow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3B82F6"
            android:text="Trigger Full-Screen Call Now (Test)"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvScheduleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No active call scheduled."
            android:textColor="#A7F3D0"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
